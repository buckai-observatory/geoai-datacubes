# Sentinel Hub / Copernicus Data Space OAuth credentials.
# Register (free) at https://dataspace.copernicus.eu/ then create an OAuth client at
# https://shapps.dataspace.copernicus.eu/dashboard/  (User settings -> OAuth clients -> Create new).
# Copy this file to ".env" (same folder) and paste your values. Never commit ".env".
SH_CLIENT_ID=your-client-id-here
SH_CLIENT_SECRET=your-client-secret-here
SH_INSTANCE_ID=
