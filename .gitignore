# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Generated by setuptools_scm on install. The version is derived from
# the latest git tag at install time; the file is regenerated automatically.
geoai_datacubes/_version.py

# YOLO pretrained weights downloaded by ultralytics into the cwd
notebooks/yolov8n.pt
notebooks/yolov8s.pt
notebooks/yolov8m.pt
yolov8n.pt
yolov8s.pt
yolov8m.pt
# Ultralytics' default training output directory if a job ran with a
# relative project= path. Real outputs live under notebooks/_outputs_obj/.
runs/

# OS
.DS_Store

# Data & model artifacts (AI-ready cubes are regenerated, not versioned)
data/
**/data/
*.tif
*.tiff
*.zarr/
**/*.zarr/
*_lmdb/
**/*_lmdb/
*.lmdb
*.mdb

# Scratch outputs generated by the notebooks. Always regeneratable on a
# fresh run; never versioned.
notebooks/_outputs/
notebooks/_ml_outputs/
notebooks/_outputs_obj/
notebooks/_outputs_nb03/
notebooks/_outputs_nb03_train/
notebooks/logs/

# Misc local caches.
cache/

# SLURM template logs (logs/ folder created by the *.sbatch templates at submit time).
slurm_examples/logs/

# Local-only HPC runbook. Each user's runbook stays personal and is never
# pushed; the docs/ folder itself is otherwise public (e.g. data_layers.md).
docs/HPC_RUNBOOK.md
