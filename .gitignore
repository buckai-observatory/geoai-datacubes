# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store

# Data & model artifacts (AI-ready cubes are regenerated, not versioned)
data/
**/data/
*.tif
*.tiff
*.zarr/
**/*.zarr/
*_lmdb/
**/*_lmdb/
*.lmdb
*.mdb

# Scratch outputs generated by the notebooks. Always regeneratable on a
# fresh run; never versioned.
notebooks/_outputs/
notebooks/_ml_outputs/
notebooks/logs/

# SLURM template logs (logs/ folder created by the *.sbatch templates at submit time).
slurm_examples/logs/
